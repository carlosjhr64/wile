#!/usr/bin/env ruby
# frozen_string_literal: true

require 'test/unit'
require 'colorize'
# Also:
# require 'cucumber'

# Cucumber Tests runs the feature suite and flunks if any scenario fails.
class TestCucumber < Test::Unit::TestCase
  def test_cucumber
    res = system('cucumber', '-f', 'progress')
    flunk 'cucumber command not found!'.red if res.nil?
    flunk 'Rotten cucumber!'.red unless res
  end
end
