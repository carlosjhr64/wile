#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'test/unit'
require 'colorize'

# Fail-less warnings of long.chaining.methods.too_much
class TestLongChains < Test::Unit::TestCase
  PATTERN = /\w+\.\w+\.\w+\.\w+/

  def test_long_chains
    Dir.glob('lib/**/*.rb').each do |filename|
      File.foreach(filename).with_index(1) do |line, line_no|
        next if /^\s*#[^{]/.match?(line) || !line.match?(PATTERN)

        puts "#{filename}:#{line_no}: #{line.strip.red}"
      end
    end
  end
end
