#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require 'prism'

# Scans Prism AST nodes for configured method calls.
class CallScanner < Prism::Visitor
  def initialize(calls)
    super()
    @calls = calls
    @found = []
  end

  def scan(source)
    Prism.parse(source).value.accept(self)
    @found
  end

  def self.match_call?(node, entry)
    pat, name = entry
    return false unless node.name == name

    recv = node.receiver&.slice
    pat.is_a?(Regexp) ? pat.match?(recv) : pat == recv
  end

  def self.label(node)
    [node.receiver&.slice, node.name].compact.join('.')
  end

  def visit_call_node(node)
    match = @calls.find { CallScanner.match_call?(node, it) }
    @found << [match[2], CallScanner.label(node), node.location.start_line] if
      match
    super
  end
end

# Fail-less lint checks for Wile's code expectations.
class TestLints < Test::Unit::TestCase
  CALLS = [
    [nil, :system, /system(?:\(|\s+)["'][a-z]/],
    ['Kernel', :system, /Kernel\.system(?:\(|\s+)["'][a-z]/],
    [nil, :spawn, /spawn(?:\(|\s+)["'][a-z]/],
    ['Kernel', :spawn, /Kernel\.spawn(?:\(|\s+)["'][a-z]/],
    ['IO', :popen, /IO\.popen(?:\(|\s+)\[?["'][a-z]/],
    # Custom calls:
    [/\bUtilities\z/, :run, /Utilities\.run(?:\(|\s+)["'][a-z]/],
    [/\bUtilities\z/, :run!, /Utilities\.run!(?:\(|\s+)["'][a-z]/]
  ].freeze

  def test_calls = quiet? || ruby_files.each { check_calls(it) }

  private

  def check_calls(filename)
    source = File.read(filename)
    lines = source.lines
    CallScanner.new(CALLS).scan(source).each do |pattern, label, num|
      alert_call("#{filename}:#{num}", [pattern, label], lines[num - 1].chomp)
    end
  end

  def alert_call(loc, match, line)
    pattern, label = match
    return if pattern.match?(line) || line.end_with?('# permit')

    puts "#{label}: #{loc}:#{line}".yellow
  end
end
