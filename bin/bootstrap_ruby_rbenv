#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

# --- Preamble: Platform, Root, Arguments, and Gem Bootstrapping ---
# The problem this section solves is that
# the main script requires gems that may be missing, so installs it.

# $ uname # with no arguments prints the kernel name
# Linux
detected_os = `uname -s`.strip
unless detected_os == 'Linux'
  warn "Error: Wile is meant to be run on Linux (detected: #{detected_os})."
  exit 69
end

%w[.version .ruby-version].each do |file|
  next if File.file?(file) && !File.empty?(file)

  warn "Error: #{file} not found -- run this from a Wile project's " \
       'root directory.'
  exit 66
end

# Check if either -v or --version is in ARGV
if ARGV.intersect?(%w[-v --version])
  puts File.read('.version').strip
  exit 0
end

# Check if either -h or --help is in ARGV
if ARGV.intersect?(%w[-h --help])
  puts <<~HELP
    Usage:
      bootstrap_ruby_rbenv [-h|--help|-v|--version]

    Description:
      Bootstraps the Ruby environment for Wile by verifying Ruby build
      dependencies, `rbenv` and its `ruby-build` plugin, updating available
      Ruby definitions, and ensuring the Ruby version in `.ruby-version` is
      installed.

      It will also install the two gems (`help_parser` and `colorize`)
      if missing.
  HELP
  exit 0
end

unless ARGV.empty?
  warn "Error: Unknown argument(s): #{ARGV.join(' ')}"
  warn 'Usage: bootstrap_ruby_rbenv [-h|--help|-v|--version]'
  exit 64
end

REQUIRED_BOOTSTRAP_GEMS = %w[help_parser colorize].freeze
missing_preamble_gems = REQUIRED_BOOTSTRAP_GEMS.reject do |gem_name|
  Gem::Specification.find_all_by_name(gem_name).any?
end

unless missing_preamble_gems.empty?
  print "Install #{missing_preamble_gems.join(', ')} with gem install? [y/N]: "
  $stdout.flush
  reply = $stdin.gets
  unless reply && /^[Yy]([Ee][Ss])?$/.match?(reply.strip)
    warn 'Aborted.'
    exit 1
  end

  cmd = ['gem', 'install', '--user-install', *missing_preamble_gems]
  unless system(*cmd)
    warn "Error: '#{cmd.join(' ')}' failed."
    exit 71
  end

  # Reset to discovered newly installed gems
  Gem.clear_paths
  REQUIRED_BOOTSTRAP_GEMS.each do |gem_name|
    require gem_name
  rescue LoadError => e
    warn "Error: Failed to load gem '#{gem_name}': #{e.message}"
    exit 69
  end
end

require_relative '../lib/wile'

# Bootstraps the Ruby environment for Wile.
# rubocop:disable-next Metrics/ClassLength
class BootstrapRubyRbenv
  include Wile::Sysexits
  include Wile::Utilities

  BUILD_PACKAGES = %w[
    autoconf
    build-essential
    git
    patch
    rustc
    libffi-dev
    libgmp-dev
    libncurses-dev
    libreadline-dev
    libssl-dev
    libyaml-dev
    zlib1g-dev
  ].freeze
  SUPPORTED_SHELLS = %w[bash fish zsh ksh].freeze
  RBENV_URL        = 'https://github.com/rbenv/rbenv.git'
  RUBY_BUILD_URL   = 'https://github.com/rbenv/ruby-build.git'

  RBENV_INFO = <<~TEXT
    `rbenv` was not found in your PATH.

    How Wile projects use `rbenv`:
      - Each project defines its target Ruby version in `.ruby-version`, which
        `rbenv` uses to automatically switch to the required Ruby (>= 4.0).
      - `wile install` and `gem install` install gems into the user-managed
        `rbenv` Ruby environment without requiring root (`sudo`) privileges.
      - `wile gemcheck` inspects `~/.rbenv/versions` to compare installed gems
        across your Ruby versions.
      - `wile requirements` checks for `rbenv` (>= 1.3).

  TEXT

  def initialize
    verify_dependencies!
    ensure_rbenv!
    ensure_ruby_build!
    ensure_target_ruby!
    verify_active_ruby!
  end

  private

  # category: dependencies
  def verify_dependencies!
    if command_available?('dpkg-query') && command_available?('apt-get')
      verify_apt_packages!
    else
      verify_generic_packages!
    end
  end

  def verify_generic_packages!
    warn <<~NOTICE
      Notice: `dpkg-query` and `apt-get` were not found to verify the
      required packages. Ensure your system has the equivalents of these
      Debian/Ubuntu packages installed, so this script can fetch `rbenv`
      and `ruby-build` and compile Ruby from source:
        #{BUILD_PACKAGES.join(' ')}
    NOTICE
    return if confirm?('Proceed assuming these requirements are satisfied?')

    error!(EX_NO, 'Aborted.')
  end

  def verify_apt_packages!
    missing = missing_packages(BUILD_PACKAGES)
    if missing.empty?
      puts 'Ruby build dependencies verified.'.green
      return
    end

    prompt_apt_install!(missing)
  end

  def prompt_apt_install!(missing)
    puts "Missing required packages: #{missing.join(' ')}".yellow
    if confirm?('Install missing packages with sudo apt-get?')
      apt_install!(missing)
    else
      warn 'Aborted. Install them manually with:'
      warn "  sudo apt-get update && sudo apt-get install #{missing.join(' ')}"
      exit EX_NO
    end
    puts 'Ruby build dependencies verified.'.green
  end

  # category: rbenv
  def ensure_rbenv!
    if command_available?('rbenv')
      puts "rbenv found: #{`rbenv --version`.strip}".green
      return
    end

    puts RBENV_INFO
    clone_rbenv_if_missing!
    configure_rbenv_shell!
  end

  # rubocop:disable-next Metrics/MethodLength
  def clone_rbenv_if_missing!
    rbenv_dir = File.expand_path('~/.rbenv')
    rbenv_bin = File.join(rbenv_dir, 'bin/rbenv')
    if File.executable?(rbenv_bin)
      puts "Found existing rbenv installation at #{rbenv_dir}."
      return
    end

    if confirm?("Clone #{RBENV_URL} into #{rbenv_dir}?")
      run_cmd!('git', 'clone', RBENV_URL, rbenv_dir)
    else
      warn 'Aborted. You can install it manually with:'
      warn "  git clone #{RBENV_URL} ~/.rbenv"
      exit EX_NO
    end
  end

  def detect_user_shell
    comm = `ps -p #{Process.ppid} -o comm= 2>/dev/null`.strip.sub(/\A-/, '')
    return comm if SUPPORTED_SHELLS.include?(comm)

    fallback = File.basename(ENV.fetch('SHELL', ''))
    return fallback if SUPPORTED_SHELLS.include?(fallback)

    return fallback unless fallback.empty?
    return comm unless comm.empty?

    'none'
  end

  def configure_rbenv_shell!
    user_shell = detect_user_shell
    unless SUPPORTED_SHELLS.include?(user_shell)
      warn "Error: Could not detect a supported shell (found: '#{user_shell}')."
      warn 'Configure your shell for rbenv manually, then re-run:'
      print_manual_rbenv_init('~/.rbenv/bin/rbenv')
      exit EX_CONFIG
    end

    prompt_configure_shell!(user_shell)
  end

  # rubocop:disable-next Metrics/MethodLength
  def prompt_configure_shell!(user_shell)
    rbenv_bin = File.expand_path('~/.rbenv/bin/rbenv')
    prompt = "Configure #{user_shell} for rbenv via " \
             "'#{rbenv_bin} init #{user_shell}'?"
    if confirm?(prompt)
      run_cmd!(rbenv_bin, 'init', user_shell)
    else
      warn 'Aborted. Configure your shell manually:'
      print_manual_rbenv_init('~/.rbenv/bin/rbenv')
      exit EX_NO
    end

    puts
    puts 'Restart your shell so the rbenv configuration takes effect, ' \
         'then re-run:'
    puts '  ./bin/bootstrap_ruby_rbenv'
    exit EX_CONFIG
  end

  def print_manual_rbenv_init(rbenv_cmd = 'rbenv')
    warn "  - For fish (~/.config/fish/config.fish):\n      " \
         "status --is-interactive; and #{rbenv_cmd} " \
         "init - --no-rehash fish | source\n  " \
         "- For bash (~/.bashrc):\n      " \
         "eval \"$(#{rbenv_cmd} init - --no-rehash bash)\""
  end

  # category: build
  def ensure_ruby_build!
    ruby_build_dir = File.join(rbenv_root, 'plugins/ruby-build')

    if File.directory?(File.join(ruby_build_dir, '.git'))
      update_ruby_build!(ruby_build_dir)
    else
      clone_ruby_build!(ruby_build_dir)
    end

    version = `rbenv install --version 2>/dev/null`.strip
    puts "ruby-build found: #{version}".green
  end

  def update_ruby_build!(ruby_build_dir)
    if confirm?("Pull latest Ruby version definitions in #{ruby_build_dir}?")
      # git -C <path> ... runs as if git was started in pathn
      return if system('git', '-C', ruby_build_dir, 'pull')

      warn 'Git pull failed, proceeding anyway...'
    else
      puts 'Skipping ruby-build update.'
    end
  end

  # rubocop:disable-next Metrics/MethodLength
  def clone_ruby_build!(ruby_build_dir)
    warn <<~TEXT
      The `ruby-build` plugin was not found at #{ruby_build_dir}.

      `rbenv` relies on the `ruby-build` plugin to provide `rbenv install`
      and keep the list of available Ruby versions up to date.
    TEXT
    prompt = "Clone #{RUBY_BUILD_URL} into #{ruby_build_dir}?"
    if confirm?(prompt)
      run_cmd!('git', 'clone', RUBY_BUILD_URL, ruby_build_dir)
    else
      warn "Aborted. You can install it manually with:\n  " \
           "git clone #{RUBY_BUILD_URL} \"#{ruby_build_dir}\""
      exit EX_NO
    end
  end

  # category: ruby
  def ensure_target_ruby!
    target = File.read('.ruby-version').strip
    installed = `rbenv versions --bare 2>/dev/null`.lines.map(&:strip)
    if installed.include?(target)
      puts "Ruby #{target} is already installed.".green
      return
    end

    prompt_target_ruby_install!(target)
  end

  # rubocop:disable-next Metrics/MethodLength
  def verify_active_ruby!
    target = File.read('.ruby-version').strip
    active_ruby = `ruby -e 'print RUBY_VERSION' 2>/dev/null`.strip
    if active_ruby == target
      puts "Ruby verified: #{`ruby --version`.strip}".green
      return
    end

    ruby_path = which('ruby') || 'not found'
    warn <<~MSG.red
      Error: Ruby #{target} is installed in rbenv, but this shell's `ruby`
      resolves to '#{active_ruby.empty? ? 'none' : active_ruby}' (#{ruby_path}).

      Your shell likely hasn't initialized `rbenv` shims. Add `rbenv init` to
      your shell configuration, restart your shell, and re-run:
    MSG
    print_manual_rbenv_init('rbenv')
    exit EX_CONFIG
  end

  def prompt_target_ruby_install!(target)
    puts "Ruby #{target} (specified in .ruby-version) is not installed.".yellow
    if confirm?("Install Ruby #{target} via rbenv now?")
      run_cmd!('rbenv', 'install', target)
      run_cmd!('rbenv', 'rehash')
    else
      warn "Aborted. You can install it later with: rbenv install #{target}"
      exit EX_NO
    end
  end
end

BootstrapRubyRbenv.new

# --- Postamble: ---
# A newly installed ruby version will also need
# the gems ensured in the preamble.

target_ruby = File.read('.ruby-version').strip
env = { 'RBENV_VERSION' => target_ruby }
missing_postamble_gems = REQUIRED_BOOTSTRAP_GEMS.reject do |gem_name|
  Wile::Utilities.gem_installed?(gem_name, env:)
end

unless missing_postamble_gems.empty?
  prompt = "Install #{missing_postamble_gems.join(', ')} into Ruby " \
           "#{target_ruby} with gem install?"
  unless Wile::Utilities.confirm?(prompt)
    Wile::Utilities.error!(Wile::Sysexits::EX_NO, 'Aborted.')
  end

  Wile::Utilities.run_cmd!('gem', 'install', *missing_postamble_gems, env:)
  system(env, 'rbenv', 'rehash') if Wile::Utilities.command_available?('rbenv')
end
