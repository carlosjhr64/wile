#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'test/unit'
require 'colorize'

# Version Tests
class TestVersion < Test::Unit::TestCase
  class << self
    attr_reader :version, :grep_version
  end

  def self.startup
    @grep_version = Dir.glob(['lib/*.rb', 'lib/*/version.rb']).lazy
                       .filter_map { File.read(it)[/\d+\.\d+\.\d+/] }
                       .first

    if File.exist?('.version')
      @version = File.read('.version').chomp
    else
      msg = 'Consider using `.version` as the authoritative VERSION source.'
      warn msg.yellow
      @version = @grep_version
    end
  end

  def setup
    flunk 'Could not get authoritative VERSION' unless version
  end

  def test_data_version
    File.exist?('data/VERSION') &&
      assert_equal(version, File.read('data/VERSION').strip)
  end

  def test_lib_version
    if grep_version
      assert_equal(version, grep_version)
    else
      # A strict prescription:
      # rubocop: disable-next Lint/InterpolationCheck
      expected = 'VERSION = File.read("#{ROOT}/.version").chomp'
      actual = Dir.glob('lib/*.rb').lazy
                  .filter_map { File.read(it)[/^\s*VERSION\s*=.*$/] }
                  .first&.strip
      assert_equal(expected, actual)
    end
  end

  def test_bin_version
    return unless (executable = Dir.glob('bin/*').find do |f|
      File.file?(f) && File.executable?(f)
    end)

    out = IO.popen([executable, '--version'], err: File::NULL, &:read)&.strip
    assert_equal(version, out)
  end

  def test_gemspec_version
    return unless (gemspec = Dir.glob('*.gemspec').first)

    assert_equal(version, File.read(gemspec)[/\d+\.\d+\.\d+/])
  end

  def test_readme_version
    return unless (readme = Dir.glob('README.*').first)

    content = File.read(readme)
    assert_equal(version, content[/\d+\.\d+\.\d+/])
    ruby_version = RUBY_VERSION.split('.').first(2).join('.')
    assert_equal(ruby_version, content[/Ruby version:.*?(\d+\.\d+)/, 1])
  end

  private

  def version
    self.class.version
  end

  def grep_version
    self.class.grep_version
  end
end
