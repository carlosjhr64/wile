#!/usr/bin/env ruby
# frozen_string_literal: true

require 'test/unit'
require 'colorize'
require 'zlib'

# Dictionary Test
class TestDictionary < Test::Unit::TestCase
  FILES = ['README.md', *Dir.glob('bin/*'), *Dir.glob('lib/**/*.rb')].freeze
  VALID = Zlib::GzipReader.open('test/cons.gz') { it.readlines.to_set(&:strip) }

  def test_dictionary
    unrecognized = words_from_files.select { unrecognized?(it) }.sort
    File.open('tmp/dictionary', 'w') { it.puts unrecognized }
    diff = `colordiff .dictionary tmp/dictionary`.strip
    assert_empty(diff, "#{'Dictionary changed:'.colorize(:blue)}\n#{diff}")
  end

  private

  def words_from_files
    FILES.flat_map do |path|
      next [] unless File.file?(path)

      extract_words(File.read(path))
    end.uniq
  end

  def extract_words(text)
    text.gsub(/([a-z])([A-Z])/, '\1 \2')
        .scan(/\\?[a-zA-Z]+/)
        .map { it.start_with?('\\') ? it[2..] : it }
        .reject(&:empty?)
        .map(&:downcase)
  end

  ### Trigram-Based Spelling ###
  # Note that `.all?` is true if not iterated.
  # If word.length<3, the word is assumed good.
  def unrecognized?(word)
    !word.chars.each_cons(3).all? { VALID.include? it.join }
  end
end
