s(:module,
  s(:const, nil, :SampleConstants),
  s(:begin,
    s(:casgn, nil, :LAMBDA,
      s(:block,
        s(:send, nil, :lambda),
        s(:args,
          s(:arg, :num)),
        s(:send,
          s(:lvar, :num), :+,
          s(:int, 1)))),
    s(:casgn, nil, :STR,
      s(:str, "hello")),
    s(:casgn, nil, :TEXT,
      s(:str, "multi word string")),
    s(:casgn, nil, :RATE,
      s(:float, 3.14)),
    s(:casgn, nil, :COUNT,
      s(:int, 42)),
    s(:casgn, nil, :MAP,
      s(:send,
        s(:hash,
          s(:pair,
            s(:sym, :a),
            s(:int, 1))), :freeze)),
    s(:casgn, nil, :REGEX,
      s(:regexp,
        s(:str, "^\\w+$"),
        s(:regopt))),
    s(:casgn, nil, :LIST,
      s(:send,
        s(:array,
          s(:int, 1),
          s(:int, 2)), :freeze)),
    s(:casgn, nil, :STATUS,
      s(:sym, :active)),
    s(:casgn, nil, :Pair,
      s(:send,
        s(:const, nil, :Struct), :new,
        s(:sym, :a),
        s(:sym, :b))),
    s(:casgn, nil, :CUSTOM,
      s(:send,
        s(:const, nil, :Object), :new))))
