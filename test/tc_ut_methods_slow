#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require_relative '../lib/wile'
require_relative '../lib/wile/run'

# Unit tests for Wile::Methods.
class TestUtMethods < Test::Unit::TestCase
  def setup
    Wile.autoloads
    @methods = Wile::Methods.new
  end

  def test_known_constants_include_constant_assignments
    assert_true @methods.known_constants.include?('Wile::CASGN_TYPES')
    assert_true @methods.known_constants.include?(
      'Wile::OrderOptimizer::SORTS'
    )
  end

  def test_undefined_methods_exclude_implicit_constructors
    assert_false @methods.undefined_methods.include?('Wile::CodeContent.new')
    assert_false @methods.undefined_methods.include?('Wile::CodeStats.new')
  end

  def test_implicit_methods_include_default_constructors
    assert_true @methods.implicit_methods.include?('Wile::CodeContent.new')
    assert_true @methods.implicit_methods.include?('Wile::CodeStats.new')
  end

  def test_undefined_methods_exclude_attr_readers
    assert_true @methods.methods.key?('Wile::Info#cache')
    assert_false @methods.undefined_methods.include?('@info#cache')
  end

  def test_star_duck_calls_record_dependants
    entry = @methods.methods['Wile::Cache#make']
    assert_true entry.dependants.include?('lib/wile/tasks/mkdir.rb')
  end

  def test_undefined_methods_include_nonexistent_methods
    entry = Wile::MethodEntry.new(mock_cdt, 'Fake#test')
    @methods.send(:add_undefined_methods, 'Wile::Tasks#fake', entry)
    assert_true @methods.undefined_methods.include?(
      'CodeData.not_a_method_anywhere'
    )
  end

  private

  def mock_cdt
    mock = Object.new
    def mock.filename = 'test.rb'
    def mock.external(_name) = ['CodeData.not_a_method_anywhere']
    def mock.dependencies(_name) = []
    def mock.dependants(_name) = []
    mock
  end
end
