^(
  ###########################################
  #  Exclude all dot files except .version  #
  ###########################################
  (\.(?!version$)) |

  ####################################
  #  Executables not to be packaged  #
  ####################################
  (bin/bootstrap) |

  ###############################
  #  Exclude Git page demos...  #
  ###############################
  (examples/) |
  (img/)      |

  #################################################
  #  Exclude development and repo maintance files #
  #################################################
  (\w+\.gemspec) |
  (Gemfile)      |
  (History\.)    |
  (sig/)         |
  (test/)        |
  (tmp/)         |
  (TODO\.)       |
  # Cucumber:
  (cucumber\.)   |
  (features/)    |
)
