#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'wile'

HelpParser[Wile::VERSION, <<~HELP]
  # ## bootstrap_fish ##
  # Bootstraps the fish shell environment for Wile by verifying or installing
  # fish (>= 4.0), configuring rbenv in ~/.config/fish/config.fish, and
  # optionally setting fish as the default login shell.
  Usage:
    bootstrap_fish [:options+]
  Options:
    -h --help
    -v --version
HELP

# Bootstraps the fish shell environment for Wile.
# rubocop:disable-next Metrics/ClassLength
class BootstrapFish
  include Wile::Sysexits

  FISH_MIN_VERSION = '4.0'
  FISH_URL         = 'https://fishshell.com/'
  RBENV_INIT_LINE  =
    'status --is-interactive; and ' \
    '~/.rbenv/bin/rbenv init - --no-rehash fish | source'

  def initialize
    verify_linux!
    verify_rbenv!
    ensure_fish!
    configure_rbenv!
    configure_default_shell!
    puts "Fish setup complete: #{`fish --version`.strip}".green
  end

  private

  def verify_linux!
    os = `uname -s`.strip
    return if os == 'Linux'

    error!(EX_UNAVAILABLE,
           "Error: Wile is meant to be run on Linux (detected: #{os}).")
  end

  def verify_rbenv!
    rbenv = File.expand_path('~/.rbenv/bin/rbenv')
    return if File.executable?(rbenv)

    error!(EX_UNAVAILABLE, <<~MSG)
      Error: rbenv not found at #{rbenv}.
      Run ./bin/bootstrap_ruby_rbenv first, then re-run:
        ./bin/bootstrap_fish
    MSG
  end

  def ensure_fish!
    version = fish_version
    if version && version_ok?(version)
      msg = "fish found: #{`fish --version`.strip} (>= #{FISH_MIN_VERSION})"
      puts msg.green
      return
    end

    explain_fish(version)
    install_fish!
  end

  def fish_version
    return nil unless command_available?('fish')

    `fish --version 2>/dev/null`[/\d+\.\d+/]
  end

  def version_ok?(version)
    Gem::Version.new(version) >= Gem::Version.new(FISH_MIN_VERSION)
  end

  def command_available?(cmd)
    !which(cmd).nil?
  end

  # rubocop:disable-next Metrics/MethodLength
  def explain_fish(version)
    if version
      puts "Found fish #{version}; Wile requires fish >= #{FISH_MIN_VERSION}."
        .yellow
    else
      puts '`fish` was not found in your PATH.'.yellow
    end
    puts <<~MSG

      How Wile projects use `fish`:
        - Wile targets the fish shell (>= #{FISH_MIN_VERSION}) for interactive
          workflows.
        - Project directories include `.config.fish`, `.greeting`, `.prompt`,
          and `.title` to configure your local project environment.
        - `wile requirements` checks for `fish` (>= #{FISH_MIN_VERSION}) and
          its plugins.

    MSG
  end

  def install_fish!
    if apt_fish_available? && confirm?('Install fish with sudo apt-get?')
      system('sudo', 'apt-get', 'update') ||
        error!(EX_OSERR, 'Error: apt-get update failed.')
      system('sudo', 'apt-get', 'install', '-y', 'fish') ||
        error!(EX_OSERR, 'Error: apt-get install fish failed.')
    end

    version = fish_version
    return if version && version_ok?(version)

    manual_fish_instructions!(version)
  end

  def apt_fish_available?
    return false unless command_available?('apt-get') &&
                        command_available?('apt-cache')

    candidate =
      `apt-cache policy fish 2>/dev/null`[/Candidate:\s*(\d+\.\d+)/, 1]
    return false unless candidate
    return true if version_ok?(candidate)

    puts "apt candidate for fish (#{candidate}) is < #{FISH_MIN_VERSION}."
      .yellow
    false
  end

  def manual_fish_instructions!(version)
    found = version ? " (currently found: #{version})" : ''
    error!(EX_UNAVAILABLE, <<~MSG)
      Error: fish >= #{FISH_MIN_VERSION} is required#{found}.
      Please install the latest release of fish (>= #{FISH_MIN_VERSION}) for
      your distribution following the instructions at:
        #{FISH_URL}
      Then re-run:
        ./bin/bootstrap_fish
    MSG
  end

  # rubocop:disable-next Metrics/MethodLength
  def configure_rbenv!
    config_file = File.expand_path('~/.config/fish/config.fish')
    if File.exist?(config_file) && File.read(config_file).include?('rbenv init')
      puts "rbenv initialization already present in #{config_file}.".green
      return
    end

    unless confirm?("Add rbenv initialization to #{config_file}?")
      error!(EX_NO, <<~MSG)
        Aborted. To configure manually, add this line to #{config_file}:
          #{RBENV_INIT_LINE}
        Then re-run:
          ./bin/bootstrap_fish
      MSG
    end

    FileUtils.mkdir_p(File.dirname(config_file))
    File.open(config_file, 'a') do |file|
      file.puts unless File.empty?(config_file)
      file.puts '# RbEnv', RBENV_INIT_LINE
    end
    puts "Updated #{config_file} with rbenv initialization.".green
  end

  # rubocop:disable-next Metrics/MethodLength
  def configure_default_shell!
    fish_path = which('fish')
    return if fish_path.nil? || ENV['SHELL'] == fish_path

    puts "Your current login shell is #{ENV['SHELL'] || 'unknown'}."
    prompt = "Set fish (#{fish_path}) as your default login shell via chsh?"
    unless confirm?(prompt)
      puts 'Skipping default shell change.'
      return
    end

    if system('chsh', '-s', fish_path)
      puts "Default shell set to #{fish_path} (re-login to take effect).".green
    else
      error!(EX_OSERR, "Error: chsh failed. Run manually: chsh -s #{fish_path}")
    end
  end

  def which(cmd)
    paths.each do |dir|
      bin = File.join(dir, cmd)
      return bin if File.file?(bin) && File.executable?(bin)
    end
    nil
  end

  def paths
    ENV.fetch('PATH', '').split(File::PATH_SEPARATOR)
  end

  def error!(val, msg)
    warn msg.red
    exit val
  end

  def confirm?(prompt)
    print "#{prompt.yellow} [y/N]: "
    $stdout.flush
    reply = $stdin.gets
    return false unless reply

    /^[Yy]([Ee][Ss])?$/.match?(reply.strip)
  end
end

BootstrapFish.new
