#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require_relative '../lib/wile'
require_relative '../lib/wile/run'

# Unit tests for Wile::ThreadPool.
class TestUtThreadPool < Test::Unit::TestCase
  def setup
    Wile.autoloads
  end

  def test_default_workers
    assert_operator Wile::ThreadPool.default_workers, :>=, 1
  end

  def test_reject_returns_falsy_items
    pool = Wile::ThreadPool.new(workers: 3)
    failed = pool.reject((1..10).to_a, &:even?)
    assert_equal [1, 3, 5, 7, 9], failed.sort
  end

  def test_reject_empty
    pool = Wile::ThreadPool.new(workers: 2)
    assert_equal [], pool.reject([]) { true }
  end

  def test_clamps_workers_to_at_least_one
    pool = Wile::ThreadPool.new(workers: 0)
    assert_equal [1, 3], pool.reject([1, 2, 3], &:even?).sort
  end
end
