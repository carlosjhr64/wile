#!/usr/bin/env ruby
# frozen_string_literal: true

# wile: os `false,ruby,true`

require 'stringio'
require 'tempfile'
require_relative 'test_helper'
require_relative '../lib/wile'

# Unit tests for Wile::Utilities.run and run!.
class TestUtUtilities < Test::Unit::TestCase
  include Wile::Sysexits

  def test_safe_run_boolean_and_block
    assert Wile::Utilities.run('true')
    assert_false Wile::Utilities.run('false')

    yielded = nil
    res = Wile::Utilities.run('false') { |code, msg| yielded = [code, msg] }
    assert_false res
    assert_equal EX_OSERR, yielded[0]
    assert_match(/Error: 'false' failed \(exit 1\)\./, yielded[1])
  end

  def test_run_echo
    prev = $stderr
    $stderr = StringIO.new
    assert Wile::Utilities.run('true', echo: true)
    assert_match(/true/, $stderr.string)
  ensure
    $stderr = prev
  end

  def test_run_success_and_env
    assert_nothing_raised do
      Wile::Utilities.run!('true')
      Wile::Utilities.run!(
        'ruby', '-e', 'exit(ENV["WILE_TEST"] == "ok" ? 0 : 1)',
        env: { 'WILE_TEST' => 'ok' }
      )
    end
  end

  def test_run_stderr_false
    assert_nothing_raised do
      Wile::Utilities.run!('ruby', '-e', 'warn "suppressed"', stderr: false)
    end
  end

  def test_run_failure_defaults
    err, status = capture_exit do
      Wile::Utilities.run!('false', env: { 'FOO' => 'bar' })
    end
    assert_equal EX_OSERR, status
    assert_match(/Error: 'FOO=bar false' failed \(exit 1\)\./, err)
  end

  def test_run_custom_sysexit_and_msg
    err, status = capture_exit do
      Wile::Utilities.run!('false', sysexit: EX_TEMPFAIL, msg: 'boom')
    end
    assert_equal EX_TEMPFAIL, status
    assert_match(/boom/, err)
  end

  def test_run_infers_unavailable
    err, status = capture_exit do
      Wile::Utilities.run!('nonexistent_cmd_xyz_123')
    end
    assert_equal EX_UNAVAILABLE, status
    assert_match(/\(exit 127\)\./, err)
  end

  def test_run_infers_noperm
    Tempfile.create('nonexec') do |file|
      File.chmod(0o644, file.path)
      err, status = capture_exit { Wile::Utilities.run!(file.path) }
      assert_equal EX_NOPERM, status
      assert_match(/\(exit 127\)\./, err)
    end
  end

  private

  def capture_exit(&)
    prev = $stderr
    $stderr = StringIO.new
    err = assert_raise(SystemExit, &)
    [$stderr.string, err.status]
  ensure
    $stderr = prev
  end
end
