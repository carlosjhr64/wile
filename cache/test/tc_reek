#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
# wile: require 'reek'

# Reek Tests
class TestReek < Test::Unit::TestCase
  REEK = %w[reek --no-progress --config .reek.yml].freeze

  def test_reek
    files = `git ls-files`
            .lines.map(&:chomp)
            .reject { it.start_with?('cache/') }
            .select { _ruby?(it) }
    flunk 'No files found for reek scan!'.red if files.empty?

    res = system(*REEK, *files)
    flunk 'reek command not found!'.red if res.nil?
    flunk 'Smelly code!'.red unless res
  end

  private

  def _ruby?(filename)
    /\.rb$/.match?(filename)
  end
end
