#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require 'stringio'
require_relative '../lib/wile'
require_relative '../lib/wile/run'
require_relative '../lib/wile/requires'
require_relative '../lib/wile/tasks'
require_relative '../lib/wile/tasks/cp'
require_relative '../lib/wile/tasks/gemcheck'
require_relative '../lib/wile/tasks/info'
require_relative '../lib/wile/tasks/mkdir'

# Unit tests for Wile::Tasks.
class TestUtTasks < Test::Unit::TestCase
  TASKS = Wile::Tasks.new

  FakeCache = Struct.new(:mapping, :copied) do
    def p2c_hash = mapping
    def copy2project(cfile, pfile, force:) = copied << [cfile, pfile, force]
  end

  def setup
    Wile.autoloads
  end

  def test_find
    assert_equal :help, TASKS.find('help')
    assert_equal :build, TASKS.find('bui')
    assert_equal :bump, TASKS.find('mp')
    assert_equal :lexicon, TASKS.find('xic')
    assert_equal :compare, TASKS.find('re')
    %w[bu xyz h].each { assert_nil TASKS.find(it) }
    assert_nil TASKS.find('')
    assert_nil TASKS.find(nil)
  end

  def test_cp_validation
    assert_raise(Wile::UsageError) { TASKS.cp(fake_options(%w[one two])) }
    assert_raise(Wile::UsageError) { TASKS.cp(fake_options([], bad: true)) }
  end

  def test_cp_flow
    cache = FakeCache.new({ 'm.txt' => 'c/m.txt' }, [])
    assert_raise(RuntimeError) { TASKS.cp(fake_options(['missing']), cache) }
    TASKS.cp(fake_options(['m'], force: true), cache)
    assert_equal [['c/m.txt', 'm.txt', true]], cache.copied
  end

  def test_gemcheck_validation
    assert_raise(Wile::UsageError) { TASKS.gemcheck(fake_options(['extra'])) }
    assert_raise(Wile::UsageError) do
      TASKS.gemcheck(fake_options([], bad: true))
    end
  end

  def test_gemcheck_logic
    inventory = { RUBY_VERSION => { 'rake' => 13 },
                  '3.4.0' => { 'pry' => 0 } }
    missing = TASKS.send(:gemcheck_missing, inventory)
    assert_equal({ 'pry' => [0, %w[3.4.0]] }, missing)
    assert_equal 1, TASKS.send(:gem_major, '(1.2.3, 0.9.0)')
    vers = %w[3.2.0 3.3.0 3.4.0 4.0.0]
    assert_equal '3.4.0', TASKS.send(:previous_version, vers, '4.0.0')
    out = capture_stdout { TASKS.send(:gemcheck_report, missing, ['3.4.0']) }
    assert_match(/Searching versions:\s+3\.4\.0/, out.uncolorize)
    assert_match(/pry \(~> 0\):\s+3\.4\.0/, out.uncolorize)
  end

  def test_mkdir
    assert_raise(Wile::UsageError) { TASKS.mkdir(fake_options([])) }
    assert_raise(Wile::UsageError) { TASKS.mkdir(fake_options(['bad!name'])) }
    assert_raise(RuntimeError) { TASKS.mkdir(fake_options(['lib'])) }
  end

  def test_info_validation
    assert_raise(Wile::UsageError) { TASKS.info(fake_options(['extra'])) }
  end

  def test_info_output
    out = capture_stdout { TASKS.info(fake_options([])) }.uncolorize
    ['# wile', '## Description', '## Files', '## Executables',
     '## Runtime gems'].each { |hdr| assert_match(/#{hdr}/, out) }
    assert_match(/\+ Version:\s+#{Wile::VERSION}/, out)
  end

  private

  def capture_stdout
    orig = $stdout
    $stdout = StringIO.new
    yield
    $stdout.string
  ensure
    $stdout = orig
  end

  def fake_options(args, flags = {})
    h = { 'task' => 'task', 'args' => args }
    flags.each { |k, v| h[k.to_s] = v }
    meths = flags.keys.map { :"#{it}?" }
    obj = Struct.new(:args, *meths).new(args, *flags.values)
    obj.define_singleton_method(:to_h) { h }
    obj
  end
end
