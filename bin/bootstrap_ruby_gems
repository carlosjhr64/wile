#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'rbconfig'

# Bootstraps Ruby gems for Wile into the active rbenv Ruby version.
class BootstrapRubyGems
  ROOT_FILES = %w[.version .ruby-version Gemfile].freeze

  USAGE = <<~TEXT
    Usage:
      bootstrap_ruby_gems [-h|--help|-v|--version]

    Description:
      Bootstraps the Ruby gems required by Wile by verifying `rbenv` and the
      active Ruby version against `.ruby-version`, updating `bundler`, and
      running `bundle update --all`.
  TEXT

  def initialize(args = ARGV)
    verify_project_root!
    parse_args!(args)
    verify_rbenv!
    verify_ruby_version!
    install_gems!
  end

  private

  def verify_project_root!
    ROOT_FILES.each do |file|
      next if File.file?(file) && !File.empty?(file)

      abort "Error: #{file} not found — " \
            "run this from a Wile project's root directory."
    end
  end

  # rubocop:disable-next Metrics/MethodLength
  def parse_args!(args)
    if args.intersect?(%w[-v --version])
      puts File.read('.version').strip
      exit 0
    end

    if args.intersect?(%w[-h --help])
      puts USAGE
      exit 0
    end

    return if args.empty?

    warn "Error: Unknown argument(s): #{args.join(' ')}"
    warn 'Usage: bootstrap_ruby_gems [-h|--help|-v|--version]'
    exit 64 # Usage
  end

  def verify_rbenv!
    rbenv = File.expand_path('~/.rbenv/bin/rbenv')
    if File.executable?(rbenv) && command_available?('rbenv')
      puts "rbenv found: #{`rbenv --version`.strip}"
      return
    end

    abort <<~MSG
      Error: rbenv not found or not initialized in PATH.
      Run ./bin/bootstrap_ruby_rbenv first, then re-run:
        ./bin/bootstrap_ruby_gems
    MSG
  end

  # rubocop:disable-next Metrics/MethodLength
  def verify_ruby_version!
    expected = File.read('.ruby-version').strip
    rbenv_root = `rbenv root`.strip
    expected_prefix = "#{rbenv_root}/versions/#{expected}/"

    if expected == RUBY_VERSION && RbConfig.ruby.start_with?(expected_prefix)
      puts "Ruby verified: #{RUBY_DESCRIPTION} (#{RbConfig.ruby})"
      return
    end

    abort <<~MSG
      Error: Expected rbenv Ruby #{expected} (from .ruby-version), but current
      ruby is #{RUBY_VERSION} at #{RbConfig.ruby}.

      Ensure ./bin/bootstrap_ruby_rbenv has been run and rbenv shims are active
      in your shell, then re-run:
        ./bin/bootstrap_ruby_gems
    MSG
  end

  def install_gems!
    unless confirm?("Update bundler and run 'bundle update --all' " \
                    "for Ruby #{RUBY_VERSION}?")
      abort 'Aborted.'
    end

    run_cmd!('gem', 'update', 'bundler')
    run_cmd!('bundle', 'update', '--all')
    run_cmd!('rbenv', 'rehash')
    puts "Ruby gems setup complete for Ruby #{RUBY_VERSION}."
  end

  def run_cmd!(*cmd)
    return if system(*cmd)

    abort "Error: '#{cmd.join(' ')}' failed."
  end

  def command_available?(cmd)
    !`which #{cmd}`.strip.empty?
  end

  def confirm?(prompt)
    print "#{prompt} [y/N]: "
    $stdout.flush
    reply = $stdin.gets
    return false unless reply

    /^[Yy]([Ee][Ss])?$/.match?(reply.strip)
  end
end

BootstrapRubyGems.new
