#!/usr/bin/env ruby
# frozen_string_literal: true

require 'test/unit'
require 'colorize'
require 'prism'

# Comments Test ensures side comments do not contain quotes or closing
# delimiters (' " / ) } ]), making it simple to split "code # comment"
# without quote or delimiter balancing.
class TestComments < Test::Unit::TestCase
  FORBIDDEN = %r{['"/)\}\]]}

  def test_comments
    errors = ruby_files.sum { check_file(it) }
    return if errors.zero?

    print 'Remove these characters from side comments: '.blue
    puts %q('"/\)}]).red
    flunk
  end

  private

  def check_file(filename)
    source = File.read(filename)
    lines = source.lines
    Prism.parse_comments(source).count do |comment|
      line = lines[comment.location.start_line - 1]
      bad_comment?(filename, comment, line)
    end
  end

  def bad_comment?(filename, comment, line)
    return false if /^\s*#/.match?(line)

    loc = comment.location
    return false unless FORBIDDEN.match?(loc.slice)

    puts_blue(filename, loc.start_line, line)
    true
  end

  def ruby_files
    `git ls-files`.lines.map(&:chomp)
                  .select { File.file?(it) }
                  .select { /\.rb$/.match?(it) || _bang_ruby?(it) }
  end

  def puts_blue(filename, line_number, comment_line)
    puts "#{filename}:#{line_number}:#{comment_line.chomp}".blue
  end

  def _bang_ruby?(filename)
    return false if /\.\w*$/.match?(filename) ||
                    File.directory?(filename) ||
                    !File.executable?(filename) ||
                    File.empty?(filename)

    /^#!.*\bruby$/.match? File.read(filename, 80).lines[0].rstrip
  end
end
