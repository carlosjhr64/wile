#!/usr/bin/env ruby
# frozen_string_literal: true

require 'test/unit'
require 'colorize'
require 'prism'

# Comments Test ensures side comments do not contain quotes or closing
# delimiters (' " / ) } ]), making it simple to split "code # comment"
# without quote or delimiter balancing.
class TestComments < Test::Unit::TestCase
  # rubocop:disable Metrics
  def test_comments
    error_count = 0
    `git ls-files`.lines.map(&:chomp) # Get all files in git...
                  .select { File.file?(it) }
                  .select { /\.rb$/.match?(it) || _bang_ruby?(it) }
                  .each do |filename|
      source = File.read(filename)
      lines = source.lines
      Prism.parse_comments(source).each do |comment|
        line_number = comment.location.start_line
        comment_line = lines[line_number - 1]
        next if /^\s*#/.match?(comment_line)
        next unless %r{['"/)\}\]]}.match?(comment.location.slice)

        error_count += 1
        puts_blue(filename, line_number, comment_line)
      end
    end
    return unless error_count.positive?

    print 'Remove these characters from side comments: '.blue
    puts %q('"/\)}]).red
    flunk
  end

  private

  def puts_blue(filename, line_number, comment_line)
    puts "#{filename}:#{line_number}:#{comment_line.chomp}".blue
  end

  def _bang_ruby?(filename)
    return false if /\.\w*$/.match?(filename) ||
                    File.directory?(filename) ||
                    !File.executable?(filename) ||
                    File.empty?(filename)

    /^#!.*\bruby$/.match? File.read(filename, 80).lines[0].rstrip
  end
  # rubocop:enable Metrics
end
