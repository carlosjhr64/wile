#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require 'find'

# Encoding Test reports non-ASCII characters and verifies valid UTF-8.
class TestEncoding < Test::Unit::TestCase
  ALLOWED_BINARY = %w[.gem .gz .ico .jpeg .jpg .pdf .png].freeze
  PRUNED         = %w[./.git ./tmp].freeze

  def test_encoding
    invalid = []
    Find.find('.') do |path|
      Find.prune if PRUNED.include?(path)
      check_path(path, invalid) if File.file?(path)
    end
    assert_empty invalid,
                 "Invalid UTF-8 sequences found:\n#{invalid.join("\n")}"
  end

  private

  def check_path(path, invalid)
    return if ALLOWED_BINARY.include?(File.extname(path))

    rel = path.delete_prefix('./')
    if binary?(path)
      invalid << "#{rel}: Unexpected binary content in text file".red
      return
    end

    scan_file(rel, invalid)
  end

  def scan_file(filename, invalid)
    File.foreach(filename, chomp: true).with_index(1) do |line, lno|
      unless line.valid_encoding? && !line.include?("\x00")
        invalid << "#{filename}:#{lno}: #{line.scrub}".red
        next
      end
      next if line.ascii_only? || quiet?

      puts "#{filename}:#{lno}: #{line}".gray
    end
  end
end
