@help
Feature: Testing <%=@project%> help

  Background:
    * Given command "./bin/<%=@project%>"

  Scenario: --help
    * Given option "--help"
    * When we run command
    * Then exit status is "0"
    * Then stderr is ""
    * Then header is "## <%=@project%> ##"
    * Then stdout includes "Usage:"

  Scenario: -h
    * Given option "-h"
    * When we run command
    * Then exit status is "0"
    * Then stderr is ""
    * Then header is "## <%=@project%> ##"
    * Then stdout includes "Usage:"

  # Setting both -h and --help triggers HelpParser's validation
  Scenario: -h --help
    * Given option "-h --help"
    * When we run command
    * Then exit status is "0"
    * Then stderr is ""
    * Then header is "## <%=@project%> ##"
    * Then stdout includes "Usage:"
