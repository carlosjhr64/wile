#!/usr/bin/env ruby
# frozen_string_literal: true

require 'test/unit'

# Version Tests
# rubocop: disable-next Style/ClassVars
class TestVersion < Test::Unit::TestCase
  GREP = 'egrep -m 1 -ho \'[0-9]+\\.[0-9]+\\.[0-9]+\''
  NULLED = '2> /dev/null'

  def self.startup
    @@grep_version = `#{GREP} lib/*.rb lib/*/version.rb #{NULLED}`.split.first

    if File.exist?('.version')
      @@version = File.read('.version').chomp
    else
      warn 'Consider using `.version` as the authoritative VERSION source.'
      @@version = @@grep_version
    end
  end

  def setup
    flunk 'Could not get authoritative VERSION' unless @@version
  end

  def test_lib_version
    if @@grep_version
      warn 'Consider reading `.version` for VERSION.'
      assert_equal(@@version, @@grep_version)
    else
      version_code = `grep VERSION lib/*.rb`.lines.first&.strip
      # A strict prescription:
      # rubocop: disable-next Lint/InterpolationCheck
      expected = 'VERSION = File.read("#{ROOT}/.version").chomp'
      assert_equal(expected, version_code)
    end
  end

  def test_data_version
    File.exist?('data/VERSION') &&
      assert_equal(@@version, File.read('data/VERSION').strip)
  end

  def test_bin_version
    if (executable = `ls bin/* 2> /dev/null`.split.first)
      assert_equal(@@version, `#{executable} --version`.strip)
    end
  end

  def test_gemspec_version
    if (gemspec = `ls *.gemspec 2> /dev/null`.split.first)
      v = `egrep -o '[0-9]+\\.[0-9]+\\.[0-9]+' #{gemspec}`.split.first
      assert_equal(@@version, v)
    end
  end

  def test_readme_version
    if (readme = `ls README.* 2> /dev/null`.split.first)
      v = `egrep -o '[0-9]+\\.[0-9]+\\.[0-9]+' #{readme}`.split.first
      assert_equal(@@version, v)
      v = /\d+\.\d+/.match(`grep 'Ruby version:' #{readme}`).to_s
      ruby_version = RUBY_VERSION.split('.').first(2).join('.')
      assert_equal(ruby_version, v)
    end
  end
end
