#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'English'
require 'find'

# ruby -c
dirs = ['lib', ('bin' if File.directory?('bin'))].compact
dirs.each do |dir|
  Find.find(dir) do |fn|
    next unless File.file?(fn)
    next unless fn.end_with?('.rb') || File.read(fn, 80).match?(/^#!.*\bruby/)

    unless system('ruby', '-c', fn, out: File::NULL)
      puts "Syntax error: #{fn}"
      exit 1
    end
  end
end

# VERSION
unless File.file?('.version')
  puts 'Could not find .version file.'
  exit 1
end

MAJOR, MINOR, BUILD = File.read('.version').chomp.split(/\D+/)
unless MAJOR && MINOR && BUILD
  puts 'Could not get VERSION.'
  exit 1
end

# BUILD
dir_args = dirs.join(' ')
staged = `git diff --cached --name-only #{dir_args}`.strip
build = if staged.empty?
          `git log -1 --pretty='%as' #{dir_args}`.strip.delete('-')[2..]
        else
          Time.now.strftime('%y%m%d')
        end

unless BUILD.start_with? build
  puts "Unexpected BUILD(#{BUILD}) !start_with?(#{build})"
  exit 1
end

# Copyright
year = Time.now.year
author = `git config --get user.name`.strip
readme = File.file?('README.md') ? File.read('README.md') : ''
unless readme.match?(/Copyright.*#{year}.*#{Regexp.escape(author)}/i)
  puts "Check README's copyright year and author."
  exit 1
end

# wile test
wile = 'bin/wile' if File.file?('bin/wile') && File.executable?('bin/wile')
wile ||= ENV.fetch('PATH', '').split(File::PATH_SEPARATOR)
            .map { |dir| File.join(dir, 'wile') }
            .find { |fn| File.file?(fn) && File.executable?(fn) }
if wile
  io = begin
    File.open('/dev/tty', 'r+')
  rescue StandardError
    $stdin if $stdin.tty?
  end

  if io
    io.print 'Run wile test? [y/N]: '
    reply = io.gets
    io.close if io.is_a?(File)
    if reply&.strip&.match?(/^[Yy]([Ee][Ss])?$/)
      lines = IO.popen([wile, 'test'], err: %i[child out], &:readlines)
      print lines.last if lines&.last
      exit 1 unless $CHILD_STATUS.success?
    end
  end
end
