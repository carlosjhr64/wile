#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'digest'
require 'fileutils'
require 'help_parser'
require 'json'
require 'tmpdir'
require_relative '../lib/wile'
require_relative '../lib/wile/sysexits'

HelpParser[Wile::VERSION, <<~HELP]
  # ## bootstrap_install_neovim ##
  # Installs or upgrades Neovim (nvim) in ~/.local/bin from the official
  # GitHub releases (nvim-linux-x86_64.tar.gz).
  Usage:
    bootstrap_install_neovim [:options+]
  Options:
    -h --help
    -v --version
HELP

# Bootstraps or upgrades Neovim from GitHub releases.
# rubocop:disable-next Metrics/ClassLength
class BootstrapInstallNeovim
  include Wile::Sysexits

  ARCH         = 'x86_64'
  UTILITIES    = %w[curl tar].freeze
  TARBALL      = 'nvim-linux-x86_64.tar.gz'
  API_URL      = 'https://api.github.com/repos/neovim/neovim/releases/latest'
  RELEASES_URL = 'https://github.com/neovim/neovim/releases/latest'
  DOWNLOAD_URL = "#{RELEASES_URL}/download/#{TARBALL}".freeze
  LOCAL_DIR    = File.expand_path('~/.local')
  BIN_DIR      = File.join(LOCAL_DIR, 'bin')
  NVIM_BIN     = File.join(BIN_DIR, 'nvim')
  CLEAN_DIRS   = [
    File.join(LOCAL_DIR, 'lib/nvim'),
    File.join(LOCAL_DIR, 'share/nvim/runtime')
  ].freeze

  def initialize
    verify_linux!
    verify_arch!
    verify_utilities!
    ensure_neovim!
    puts 'Neovim setup OK.'
  end

  private

  def verify_linux!
    os = `uname -s`.strip
    return if os == 'Linux'

    error!(EX_UNAVAILABLE,
           "Error: Wile is meant to be run on Linux (detected: #{os}).")
  end

  def verify_arch!
    arch = `uname -m`.strip
    return if arch == ARCH

    error!(EX_UNAVAILABLE,
           "Error: #{ARCH} architecture required (detected: #{arch}).")
  end

  def verify_utilities!
    missing = UTILITIES.select { |cmd| `which #{cmd}`.strip.empty? }
    return if missing.empty?

    error!(EX_UNAVAILABLE,
           "Error: Required utilities not found in PATH: #{missing.join(', ')}")
  end

  def ensure_neovim!
    fetch_latest_release!
    current = installed_version
    if current && Gem::Version.new(current) >= Gem::Version.new(@latest_version)
      puts "nvim found: v#{current} (latest: v#{@latest_version})"
      return
    end

    prompt_install!(current)
    install_neovim!
    verify_neovim!
  end

  def prompt_install!(current)
    action =
      if current
        "Upgrade nvim (v#{current} -> v#{@latest_version})"
      else
        "Install nvim v#{@latest_version}"
      end
    confirm?("#{action} in #{BIN_DIR}?") || error!(EX_NO, 'Aborted.')
  end

  def fetch_latest_release!
    data = JSON.parse(`curl -fsSL #{API_URL} 2>/dev/null`)
    @latest_version = data.fetch('tag_name', '')[/\d+\.\d+\.\d+/]
    @expected_sha256 = extract_sha256(data.fetch('assets', []))
    return if @latest_version && @expected_sha256

    error!(EX_UNAVAILABLE, "Error: Invalid release data from #{API_URL}.")
  rescue JSON::ParserError
    error!(EX_UNAVAILABLE, "Error: Failed to fetch release from #{API_URL}.")
  end

  def extract_sha256(assets)
    asset = assets.find { |item| item['name'] == TARBALL }
    asset ? asset.fetch('digest', '')[/\Asha256:(\h{64})\z/, 1] : nil
  end

  def installed_version
    bin = File.executable?(NVIM_BIN) ? NVIM_BIN : `which nvim`.strip
    return nil if bin.empty?

    `#{bin} --version 2>/dev/null`[/NVIM v(\d+\.\d+\.\d+)/, 1]
  end

  def install_neovim!
    Dir.mktmpdir do |dir|
      archive = File.join(dir, TARBALL)
      download_archive!(archive)
      verify_checksum!(archive)
      extract_archive!(archive)
    end
  end

  def download_archive!(archive)
    puts "Downloading #{DOWNLOAD_URL}..."
    return if system('curl', '-fL', '--progress-bar', '-o', archive,
                     DOWNLOAD_URL)

    error!(EX_OSERR, 'Error: Failed to download Neovim archive.')
  end

  def verify_checksum!(archive)
    actual = Digest::SHA256.file(archive).hexdigest
    if actual == @expected_sha256
      puts "SHA256 verified: #{actual}"
      return
    end

    error!(EX_DATAERR, <<~MSG)
      Error: SHA256 checksum mismatch for #{TARBALL}.
        expected: #{@expected_sha256}
        actual:   #{actual}
    MSG
  end

  def extract_archive!(archive)
    FileUtils.rm_rf(CLEAN_DIRS)
    FileUtils.mkdir_p(LOCAL_DIR)
    return if system('tar', '-C', LOCAL_DIR, '--strip-components=1',
                     '-xzf', archive)

    error!(EX_OSERR, 'Error: Failed to extract Neovim archive.')
  end

  def verify_neovim!
    version = installed_version
    if version && Gem::Version.new(version) >= Gem::Version.new(@latest_version)
      puts "nvim installed: #{NVIM_BIN} (v#{version})"
      check_path_notice
      return
    end

    error!(EX_UNAVAILABLE,
           "Error: nvim >= #{@latest_version} required " \
           "(found: #{version || 'none'}).")
  end

  def check_path_notice
    paths = ENV.fetch('PATH', '').split(File::PATH_SEPARATOR)
    return if paths.include?(BIN_DIR)

    warn "Notice: #{BIN_DIR} is not currently in your PATH."
  end

  def error!(val, msg)
    warn msg
    exit val
  end

  def confirm?(prompt)
    print "#{prompt} [y/N]: "
    $stdout.flush
    reply = $stdin.gets
    return false unless reply

    /^[Yy]([Ee][Ss])?$/.match?(reply.strip)
  end
end

BootstrapInstallNeovim.new
