#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'help_parser'
require_relative '../lib/wile'
require_relative '../lib/wile/sysexits'

HelpParser[Wile::VERSION, <<~HELP]
  # ## bootstrap_system_commands ##
  # Bootstraps the Linux system commands used by Wile by verifying or
  # installing required commands (colordiff) and optional commands
  # (tmux, ncal) via apt-get.
  Usage:
    bootstrap_system_commands [:options+]
  Options:
    -h --help
    -v --version
HELP

# Bootstraps Linux system commands for Wile.
class BootstrapSystemCommands
  include Wile::Sysexits

  UTILITIES         = %w[apt-get sudo].freeze
  REQUIRED_COMMANDS = %w[colordiff].freeze
  OPTIONAL_COMMANDS = %w[tmux ncal].freeze

  def initialize
    verify_linux!
    if !system_commands_check? && utilities_check?
      ensure_commands!
      verify_commands!
    end
    puts 'System commands setup OK.'
  end

  private

  def verify_linux!
    os = `uname -s`.strip
    return if os == 'Linux'

    error!(EX_UNAVAILABLE,
           "Error: Wile is meant to be run on Linux (detected: #{os}).")
  end

  def system_commands_check?
    @missed_required = check_commands(REQUIRED_COMMANDS)
    @missed_optional = check_commands(OPTIONAL_COMMANDS)
    @missed_required.empty? && @missed_optional.empty?
  end

  def check_commands(commands)
    commands.reject do |cmd|
      path = `which #{cmd}`.strip
      found = !path.empty?
      puts "#{cmd} found: #{path}" if found
      found
    end
  end

  def utilities_check?
    missing = missing_from(UTILITIES)
    return true if missing.empty?

    warn "Error: Required utilities not found in PATH: #{missing.join(', ')}"
    verify_commands!
    false
  end

  def ensure_commands!
    missing = @missed_required + @missed_optional
    puts "Missing system commands: #{missing.join(', ')}"
    return unless confirm?("Install #{missing.join(', ')} with sudo apt-get?")

    install_commands!(missing)
    @missed_required = missing_from(@missed_required)
    @missed_optional = missing_from(@missed_optional)
  end

  def install_commands!(packages)
    system('sudo', 'apt-get', 'update') ||
      error!(EX_OSERR, 'Error: apt-get update failed.')
    system('sudo', 'apt-get', 'install', '-y', *packages) ||
      error!(EX_OSERR, 'Error: apt-get install failed.')
  end

  def missed_optional_notice
    warn "Notice: Missed optional packages: #{@missed_optional.join(', ')}"
  end

  def missed_required_notice!
    error!(EX_UNAVAILABLE,
           "Error: Missed required packages: #{@missed_required.join(', ')}")
  end

  def verify_commands!
    missed_optional_notice unless @missed_optional.empty?
    return if @missed_required.empty?

    missed_required_notice!
  end

  def missing_from(commands)
    commands.reject { |cmd| command_available?(cmd) }
  end

  def command_available?(cmd)
    !`which #{cmd}`.strip.empty?
  end

  def error!(val, msg)
    warn msg
    exit val
  end

  def confirm?(prompt)
    print "#{prompt} [y/N]: "
    $stdout.flush
    reply = $stdin.gets
    return false unless reply

    /^[Yy]([Ee][Ss])?$/.match?(reply.strip)
  end
end

BootstrapSystemCommands.new
