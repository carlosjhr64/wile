#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'tmpdir'
require_relative 'test_helper'
require_relative '../lib/wile'
require_relative '../lib/wile/usage_error'
require_relative '../lib/wile/help'

# Unit tests for Wile::UsageError.
class TestUtUsageError < Test::Unit::TestCase
  def test_usage_error_initialize_prepends_help_for_task_key
    error = Wile::UsageError.new('list: too many arguments')
    assert_includes error.message, '## wile list ##'
    assert_includes error.message, 'too many arguments'
  end

  def test_usage_error_initialize_passes_unformatted_message
    error = Wile::UsageError.new('simple error without colon')
    assert_equal 'simple error without colon', error.message
  end

  def test_usage_error_initialize_undocumented_key_passes_through
    Dir.mktmpdir do |dir|
      FileUtils.mkdir(File.join(dir, '.tasks'))
      File.write(File.join(dir, '.tasks/test_undocumented.rb'),
                 "# No help header\nputs 123\n")
      error = Dir.chdir(dir) do
        Wile::UsageError.new('test_undocumented: custom error')
      end
      assert_equal 'test_undocumented: custom error', error.message
    end
  end

  def test_usage_error_initialize_inherits_error_info_message
    error = begin
      raise 'original failure'
    rescue RuntimeError
      Wile::UsageError.new
    end
    assert_equal 'original failure', error.message
  end

  def test_usage_error_initialize_nil_message
    error = Wile::UsageError.new(nil)
    assert_equal 'Wile::UsageError', error.message
  end

  def test_usage_error_initialize_raises_on_nonexistent_key
    assert_raise(ArgumentError) do
      Wile::UsageError.new('nonexistent_task_key: some message')
    end
  end
end
