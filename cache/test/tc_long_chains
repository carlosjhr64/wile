#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'test/unit'
require 'colorize'
require 'prism'

# Fail-less warnings of long.chaining.methods.too_much
class TestLongChains < Test::Unit::TestCase
  PATTERN = /\w+\.\w+\.\w+\.\w+/

  def test_long_chains
    Dir.glob('lib/**/*.rb').each { scan_file(it) }
  end

  private

  def scan_file(filename)
    source = File.read(filename)
    raw_lines = source.lines
    strip_comments(source).lines.each_with_index do |clean, idx|
      next unless clean.match?(PATTERN)

      puts "#{filename}:#{idx + 1}: #{raw_lines[idx].strip.red}"
    end
  end

  def strip_comments(source)
    clean = source.dup
    Prism.parse_comments(source).reverse_each do |comment|
      loc = comment.location
      blank = loc.slice.gsub(/[^\r\n]/, ' ')
      clean.bytesplice(loc.start_offset, loc.length, blank)
    end
    clean
  end
end
