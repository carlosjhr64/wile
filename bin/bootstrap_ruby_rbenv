#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Error: Wile is meant to be run on Linux (detected: $(uname -s))." >&2
  exit 1
fi

for f in .version .ruby-version; do
  if [[ ! -s "${f}" ]]; then
    echo "Error: ${f} not found — run this from a Wile project's root directory." >&2
    exit 1
  fi
done

for arg in "$@"; do
  if [[ "${arg}" == "--version" || "${arg}" == "-v" ]]; then
    cat .version
    exit 0
  fi
done

for arg in "$@"; do
  if [[ "${arg}" == "--help" || "${arg}" == "-h" ]]; then
    cat <<'EOF'
Usage:
  bootstrap_ruby_rbenv [-h|--help|-v|--version]

Description:
  Bootstraps the Ruby environment for Wile by verifying Ruby build
  dependencies, `rbenv` and its `ruby-build` plugin, updating available
  Ruby definitions, and ensuring the Ruby version in `.ruby-version` is
  installed.
EOF
    exit 0
  fi
done

if [[ $# -gt 0 ]]; then
  echo "Error: Unknown argument(s): $*" >&2
  echo "Usage: bootstrap_ruby_rbenv [-h|--help|-v|--version]" >&2
  exit 64 # Usage
fi

confirm() {
  local prompt="$1"
  local reply
  read -r -p "${prompt} [y/N]: " reply
  [[ "${reply}" =~ ^[Yy]([Ee][Ss])?$ ]]
}

REQUIRED_PACKAGES=(
  autoconf
  build-essential
  patch
  rustc
  libffi-dev
  libgmp-dev
  libncurses-dev
  libreadline-dev
  libssl-dev
  libyaml-dev
  zlib1g-dev
)

if command -v dpkg-query >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
  MISSING_PACKAGES=()
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if [[ "$(dpkg-query -W -f='${db:Status-Status}' "${pkg}" 2>/dev/null || true)" != "installed" ]]; then
      MISSING_PACKAGES+=("${pkg}")
    fi
  done

  if [[ ${#MISSING_PACKAGES[@]} -gt 0 ]]; then
    echo "Missing packages required to compile Ruby: ${MISSING_PACKAGES[*]}"
    if confirm "Install missing packages with sudo apt-get?"; then
      sudo apt-get update
      sudo apt-get install -y "${MISSING_PACKAGES[@]}"
    else
      echo "Aborted. Install them manually with:" >&2
      echo "  sudo apt-get update && sudo apt-get install ${MISSING_PACKAGES[*]}" >&2
      exit 1
    fi
  fi
  echo "Ruby build dependencies verified."
else
  cat >&2 <<EOF
Notice: \`dpkg-query\` and \`apt-get\` were not found to verify Ruby build dependencies.
Ensure your system has the equivalents of these Debian/Ubuntu packages installed
so \`rbenv\` can compile Ruby from source:
  ${REQUIRED_PACKAGES[*]}
EOF
  if ! confirm "Proceed assuming these Ruby build requirements are satisfied?"; then
    echo "Aborted." >&2
    exit 1
  fi
fi

if ! command -v rbenv >/dev/null 2>&1; then
  cat <<'EOF'
`rbenv` was not found in your PATH.

How Wile projects use `rbenv`:
  - Each project defines its target Ruby version in `.ruby-version`, which
    `rbenv` uses to automatically switch to the required Ruby (>= 4.0).
  - `wile install` and `gem install` install gems into the user-managed
    `rbenv` Ruby environment without requiring root (`sudo`) privileges.
  - `wile gemcheck` inspects `~/.rbenv/versions` to compare installed gems
    across your Ruby versions.
  - `wile requirements` checks for `rbenv` (>= 1.3).

EOF

  if [[ ! -x "${HOME}/.rbenv/bin/rbenv" ]]; then
    if confirm "Clone https://github.com/rbenv/rbenv.git into ${HOME}/.rbenv?"; then
      git clone https://github.com/rbenv/rbenv.git "${HOME}/.rbenv"
    else
      echo "Aborted. You can install it manually with:" >&2
      echo "  git clone https://github.com/rbenv/rbenv.git ~/.rbenv" >&2
      exit 1
    fi
  else
    echo "Found existing rbenv installation at ${HOME}/.rbenv."
  fi

  USER_SHELL="$(ps -p "${PPID}" -o comm= 2>/dev/null || true)"
  USER_SHELL="${USER_SHELL##-}"
  case "${USER_SHELL}" in
    bash|fish|zsh|ksh) ;;
    *) USER_SHELL="${SHELL##*/}" ;;
  esac

  if confirm "Configure ${USER_SHELL} for rbenv via '${HOME}/.rbenv/bin/rbenv init ${USER_SHELL}'?"; then
    "${HOME}/.rbenv/bin/rbenv" init "${USER_SHELL}"
  else
    cat >&2 <<'EOF'
Aborted. Configure your shell manually:
  - For fish (~/.config/fish/config.fish):
      status --is-interactive; and ~/.rbenv/bin/rbenv init - --no-rehash fish | source
  - For bash (~/.bashrc):
      eval "$(~/.rbenv/bin/rbenv init - --no-rehash bash)"
EOF
    exit 1
  fi

  echo
  echo "Restart your shell so the rbenv configuration takes effect, then re-run:"
  echo "  ./bin/bootstrap_ruby_rbenv"
  exit 0
fi

echo "rbenv found: $(rbenv --version)"

RUBY_BUILD_DIR="$(rbenv root)/plugins/ruby-build"

if [ ! -d "${RUBY_BUILD_DIR}/.git" ]; then
  cat >&2 <<EOF
The \`ruby-build\` plugin was not found at ${RUBY_BUILD_DIR}.

\`rbenv\` relies on the \`ruby-build\` plugin to provide \`rbenv install\`
and keep the list of available Ruby versions up to date.
EOF
  if confirm "Clone https://github.com/rbenv/ruby-build.git into ${RUBY_BUILD_DIR}?"; then
    git clone https://github.com/rbenv/ruby-build.git "${RUBY_BUILD_DIR}"
  else
    echo "Aborted. You can install it manually with:" >&2
    echo "  git clone https://github.com/rbenv/ruby-build.git \"${RUBY_BUILD_DIR}\"" >&2
    exit 1
  fi
else
  if confirm "Pull latest Ruby version definitions in ${RUBY_BUILD_DIR}?"; then
    git -C "${RUBY_BUILD_DIR}" pull || echo "Git pull failed, proceeding anyway..." >&2
  else
    echo "Skipping ruby-build update."
  fi
fi

echo "ruby-build found: $(rbenv install --version)"

RUBY_VERSION="$(tr -d '[:space:]' < .ruby-version)"

if rbenv versions --bare | grep -Fxq "${RUBY_VERSION}"; then
  echo "Ruby ${RUBY_VERSION} is already installed."
else
  echo "Ruby ${RUBY_VERSION} (specified in .ruby-version) is not installed."
  if confirm "Install Ruby ${RUBY_VERSION} via rbenv now?"; then
    rbenv install "${RUBY_VERSION}"
    rbenv rehash
  else
    echo "Aborted. You can install it later with: rbenv install ${RUBY_VERSION}" >&2
    exit 1
  fi
fi

ACTIVE_RUBY="$(ruby -e 'print RUBY_VERSION' 2>/dev/null || true)"
if [[ "${ACTIVE_RUBY}" != "${RUBY_VERSION}" ]]; then
  cat >&2 <<EOF
Error: Ruby ${RUBY_VERSION} is installed in rbenv, but this shell's \`ruby\`
resolves to '${ACTIVE_RUBY:-none}' ($(command -v ruby || echo 'not found')).

Your shell likely hasn't initialized \`rbenv\` shims. Add \`rbenv init\` to your
shell configuration, restart your shell, and re-run:
  - fish (~/.config/fish/config.fish):
      status --is-interactive; and rbenv init - fish | source
  - bash (~/.bashrc):
      eval "\$(rbenv init - bash)"
EOF
  exit 1
fi

echo "Ruby verified: $(ruby --version)"


