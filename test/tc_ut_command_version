#!/usr/bin/env ruby
# frozen_string_literal: true

require 'tmpdir'
require_relative 'test_helper'
require_relative '../lib/wile'
require_relative '../lib/wile/run'

# Unit tests for Wile::CommandVersion.
class TestUtCommandVersion < Test::Unit::TestCase
  def setup
    Wile.autoloads
    @cv = Wile::CommandVersion.new
  end

  def test_commands_and_sizes
    assert_kind_of Array, @cv.commands
    assert_false @cv.empty?
    assert_equal @cv.commands.size, @cv.size
    assert_equal @cv.size, @cv.length
    assert_includes @cv.commands, 'git'
    assert_includes @cv.commands, 'ruby'
  end

  def test_expected
    assert_match(/\A\d+\.\d+/, @cv.expected!('git'))
    assert_raise(RuntimeError) { @cv.expected!('nonexistent_cmd_xyz') }
    with_home('/tmp/no_such_home_for_test_xyz') do
      assert_raise(RuntimeError) { @cv.expected!('carlosjhr64/theme-local') }
    end
  end

  def test_membership
    assert_true @cv.key?('ruby')
    assert_false @cv.key?('nonexistent_cmd_xyz')
    assert_true @cv.include?(['ruby', 'ruby --version'])
    assert_false @cv.include?('ruby')
    assert_false @cv.include?(['nonexistent_cmd_xyz', '--version'])
  end

  def test_enumerable_and_to_h
    hash = @cv.to_h
    assert_kind_of Hash, hash
    assert_equal @cv.size, hash.size
    assert_equal 'ruby --version', hash['ruby']
    assert_equal :man, hash['ncal']

    pairs = @cv.map { |cmd, probe| [cmd, probe] }
    assert_equal ['git', 'git --version'], pairs.assoc('git')
  end

  def test_bracket_probe_string
    assert_match(/\A\d+\.\d+\z/, @cv['ruby'])
    assert_nil @cv['nonexistent_cmd_xyz']
    with_home('/tmp/no_such_home_for_test_xyz') do
      assert_nil @cv['carlosjhr64/theme-local']
    end
  end

  def test_version
    assert_match(/\A\d+\.\d+/, @cv.version('git'))
    assert_match(/\A\d+\.\d+/, @cv.version('hostname'))
    assert_nil @cv.version('nonexistent_cmd_xyz')
  end

  def test_guess
    assert_match(/\A\d+\.\d+/, @cv.guess('git'))
    assert_match(/\A\d+\.\d+/, @cv.guess('clear'))
    assert_match(/\A\d+\.\d+/, @cv.guess('pandoc'))
    assert_match(/\A[12]\d{3}\z/, @cv.guess('kill'))
    assert_nil @cv.guess('nonexistent_cmd_xyz')
  end

  def test_custom_file
    Dir.mktmpdir do |dir|
      custom_tsv = File.join(dir, 'custom.tsv')
      File.write(custom_tsv, "mytool\tmytool --version\n")
      custom_cv = Wile::CommandVersion.new(custom_tsv)
      assert_equal 1, custom_cv.size
      assert_true custom_cv.key?('mytool')
      assert_equal 'mytool --version', custom_cv.to_h['mytool']
    end
  end

  def test_fish_plugin
    Dir.mktmpdir do |dir|
      fake_home = File.join(dir, 'home')
      plugins_file = File.join(fake_home, '.config/fish/fish_plugins')
      FileUtils.mkdir_p(File.dirname(plugins_file))
      content = "carlosjhr64/theme-local\nIlanCosman/tide@v6\n" \
                "jorgebucaran/fisher@4.4.8\n"
      File.write(plugins_file, content)

      test_fish_home(fake_home, dir)
    end
  end

  def test_man_probe
    assert_match(/\A\d+\.\d+\z/, @cv.man('diff'))
    assert_match(/\A[12]\d{3}\z/, @cv.man('kill'))
    assert_nil @cv.man('nonexistent_man_xyz_123')
  end

  private

  def test_fish_home(fake_home, dir)
    with_home(fake_home) do
      assert_equal '0', @cv.fish_plugin('carlosjhr64/theme-local')
      assert_equal '6', @cv.fish_plugin('IlanCosman/tide')
      assert_equal '4.4.8', @cv.fish_plugin('jorgebucaran/fisher')
      assert_nil @cv.fish_plugin('missing/plugin')
    end

    with_home(File.join(dir, 'no_home')) do
      assert_nil @cv.fish_plugin('carlosjhr64/theme-local')
    end
  end

  def with_home(dir)
    # rubocop:disable-next Style/EnvHome
    orig = ENV.fetch('HOME', nil)
    ENV['HOME'] = dir
    yield
  ensure
    ENV['HOME'] = orig
  end
end
