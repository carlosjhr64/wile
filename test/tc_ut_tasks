#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require 'stringio'
require_relative '../lib/wile'
require_relative '../lib/wile/run'
require_relative '../lib/wile/requires'
require_relative '../lib/wile/tasks'
require_relative '../lib/wile/tasks/build'
require_relative '../lib/wile/tasks/cp'
require_relative '../lib/wile/tasks/gemcheck'
require_relative '../lib/wile/tasks/gemfile'
require_relative '../lib/wile/tasks/info'
require_relative '../lib/wile/tasks/mkdir'
require_relative '../lib/wile/tasks/review'

FakeCache = Struct.new(:mapping, :copied) do
  def p2c_hash = mapping
  def copy2project(cfile, pfile, force:) = copied << [cfile, pfile, force]
end

FakeGmu = Struct.new(:calls) do
  def clean! = calls << :clean!
  def ready! = calls << :ready!
  def build! = calls << :build!
end

FakeGemspec = Struct.new(:rungems, :devgems)
FakeGem = Struct.new(:name)

# Helper methods for UtTasks tests.
module UtTasksHelpers
  def capture_stdout
    orig = $stdout
    $stdout = StringIO.new
    yield
    $stdout.string
  ensure
    $stdout = orig
  end

  def fake_options(args, flags = {})
    h = { 'task' => 'task', 'args' => args }
    flags.each { |k, v| h[k.to_s] = v }
    meths = flags.keys.map { :"#{it}?" }
    obj = Struct.new(:args, *meths).new(args, *flags.values)
    obj.define_singleton_method(:to_h) { h }
    obj
  end
end

# Unit tests for Wile::Tasks.
class TestUtTasks < Test::Unit::TestCase
  include UtTasksHelpers

  TASKS = Wile::Tasks.new

  def setup
    Wile.autoloads
  end

  def test_find
    assert_equal :help, TASKS.find('help')
    assert_equal :build, TASKS.find('bui')
    assert_equal :bump, TASKS.find('mp')
    assert_equal :lexicon, TASKS.find('xic')
    assert_equal :compare, TASKS.find('re')
    %w[bu xyz h].each { assert_nil TASKS.find(it) }
    assert_nil TASKS.find('')
    assert_nil TASKS.find(nil)
  end

  def test_usage_validations
    [fake_options(%w[a b]), fake_options([], bad: true)].each do |opt|
      assert_raise(Wile::UsageError) { TASKS.review(opt) }
      assert_raise(Wile::UsageError) { TASKS.cp(opt) }
      assert_raise(Wile::UsageError) { TASKS.build(opt) }
      assert_raise(Wile::UsageError) { TASKS.gemfile(opt) }
    end
    assert_raise(Wile::UsageError) { TASKS.mkdir(fake_options([])) }
  end

  def test_gemfile_flow
    spec = FakeGemspec.new([FakeGem.new('a')],
                           [FakeGem.new('a'), FakeGem.new('b')])
    io = StringIO.new
    TASKS.gemfile(fake_options([]), spec, io:)
    assert_match(/gem 'a'/, io.string)
    assert_match(/gem 'b'/, io.string)
    assert_equal 1, io.string.scan("gem 'a'").size
  end

  def test_build_flow
    gmu = FakeGmu.new([])
    TASKS.build(fake_options([], force: true), gmu)
    assert_equal [:build!], gmu.calls
  end

  def test_cp_flow
    cache = FakeCache.new({ 'm.txt' => 'c/m.txt' }, [])
    assert_raise(RuntimeError) { TASKS.cp(fake_options(['missing']), cache) }
    TASKS.cp(fake_options(['m'], force: true), cache)
    assert_equal [['c/m.txt', 'm.txt', true]], cache.copied
  end

  def test_review_files
    rev = Wile::Review.allocate
    assert_equal ['lib/wile.rb'], rev.send(:review_files, 'lib/wile.rb')
    assert_raise(RuntimeError) { rev.send(:review_files, 'nonexistent_xyz') }
    rev.instance_variable_set(:@files, ['lib/wile.rb'])
    rev.instance_variable_set(:@index, 0)
    rev.send(:review_response_cases, 'R')
    assert_equal 0, rev.instance_variable_get(:@index)
  end

  def test_review_choice
    rev = Wile::Review.allocate
    rev.instance_variable_set(:@auto, false)
    old_stdin = $stdin
    $stdin = StringIO.new("q\n")
    out = capture_stdout { rev.send(:review_choice, %i[reek rubocop]) }
    assert_match(/Failed: reek, rubocop/, out.uncolorize)
  ensure
    $stdin = old_stdin
  end

  def test_gemcheck_logic
    inventory = { RUBY_VERSION => { 'rake' => [12] },
                  '3.4.0' => { 'rake' => [12, 13], 'pry' => [0] } }
    missing = TASKS.send(:gemcheck_missing, inventory)
    assert_equal %w[3.4.0], missing[['rake', 13]]
    assert_equal %w[3.4.0], missing[['pry', 0]]
    assert_equal [0, 1], TASKS.send(:gem_majors, '(1.2.3, 0.9.0)')
    vers = %w[3.2.0 3.3.0 3.4.0 4.0.0]
    assert_equal '3.4.0', TASKS.send(:previous_version, vers, '4.0.0')
    out = capture_stdout { TASKS.send(:gemcheck_report, missing, ['3.4.0']) }
    assert_match(/pry \(~> 0\):\s+3\.4\.0/, out.uncolorize)
  end

  def test_mkdir
    assert_raise(Wile::UsageError) { TASKS.mkdir(fake_options([])) }
    assert_raise(Wile::UsageError) { TASKS.mkdir(fake_options(['bad!name'])) }
    assert_raise(RuntimeError) { TASKS.mkdir(fake_options(['lib'])) }
  end

  def test_info_validation
    assert_raise(Wile::UsageError) { TASKS.info(fake_options(['extra'])) }
  end

  def test_info_output
    out = capture_stdout { TASKS.info(fake_options([])) }.uncolorize
    ['# wile', '## Description', '## Files', '## Executables',
     '## Runtime gems'].each { |hdr| assert_match(/#{hdr}/, out) }
    assert_match(/\+ Version:\s+#{Wile::VERSION}/, out)
  end
end
