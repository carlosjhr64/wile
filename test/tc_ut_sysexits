#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative 'test_helper'
require_relative '../lib/wile'

# Unit tests for Wile::Sysexits.
class TestUtSysexits < Test::Unit::TestCase
  include Wile::Sysexits

  def test_code_msg_known_prefix
    assert_equal [EX_DATAERR, 'bad input'],
                 Wile::Sysexits.code_msg('DATAERR: bad input')
    assert_equal [EX_NOINPUT, 'missing file'],
                 Wile::Sysexits.code_msg('NOINPUT: missing file')
    assert_equal [EX_OSERR, 'failed'],
                 Wile::Sysexits.code_msg('OSERR: failed')
    assert_equal [EX_DATAERR, ''],
                 Wile::Sysexits.code_msg('DATAERR:')
    assert_equal [EX_OK, 'done'],
                 Wile::Sysexits.code_msg('OK: done')
  end

  def test_code_msg_fallback_to_fail
    assert_equal [EX_FAIL, 'Plain failure'],
                 Wile::Sysexits.code_msg('Plain failure')
    assert_equal [EX_FAIL, 'OK'],
                 Wile::Sysexits.code_msg('OK')
    assert_equal [EX_FAIL, 'TODO: not a code'],
                 Wile::Sysexits.code_msg('TODO: not a code')
    assert_equal [EX_FAIL, ''], Wile::Sysexits.code_msg('')
    assert_equal [EX_FAIL, ''], Wile::Sysexits.code_msg(nil)
  end

  def test_stop_and_no_codes
    assert_equal 2, EX_NO
    assert_equal 2, EX_STOP
    assert_equal [EX_STOP, ''], Wile::Sysexits.code_msg('STOP:')
    assert_equal [EX_NO, 'Aborted.'], Wile::Sysexits.code_msg('NO: Aborted.')
  end

  def test_label
    assert_equal 'UNAVAILABLE', Wile::Sysexits.label(EX_UNAVAILABLE)
    assert_equal 'OSERR', Wile::Sysexits.label(EX_OSERR)
    assert_equal 'NOPERM', Wile::Sysexits.label(EX_NOPERM)
    assert_equal 'FAIL', Wile::Sysexits.label(999)
  end
end
