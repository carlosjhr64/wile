#!/usr/bin/env ruby
# frozen_string_literal: true

Encoding.default_external = Encoding::UTF_8

require 'rbconfig'
require_relative '../lib/wile'

HelpParser[Wile::VERSION, <<~HELP]
  # ## bootstrap_ruby_gems ##
  # Bootstraps the Ruby gems required by Wile by verifying `rbenv` and the
  # active Ruby version against `.ruby-version`, updating `bundler`, and
  # running `bundle update --all`.
  Usage:
    bootstrap_ruby_gems [:options+]
  Options:
    -h --help
    -v --version
HELP

# Bootstraps Ruby gems for Wile into the active rbenv Ruby version.
class BootstrapRubyGems
  include Wile::Sysexits
  include Wile::Utilities

  def initialize
    verify_project_root!
    verify_rbenv!(require_in_path: true, re_run: './bin/bootstrap_ruby_gems')
    verify_ruby_project_version!(re_run: './bin/bootstrap_ruby_gems')
    install_gems!
  end

  private

  def install_gems!
    unless confirm?("Update bundler and run 'bundle update --all' " \
                    "for Ruby #{RUBY_VERSION}?")
      error!(EX_NO, 'Aborted.')
    end

    run_cmd!('gem', 'update', 'bundler')
    run_cmd!('bundle', 'update', '--all')
    run_cmd!('rbenv', 'rehash')
    verify_gems! # Sanity check
    puts "Ruby gems setup complete for Ruby #{RUBY_VERSION}."
  end

  def verify_gems!
    if system(RbConfig.ruby, '-rbundler/setup', '-rhelp_parser', '-e', '')
      return
    end

    error!(EX_UNAVAILABLE,
           'Error: gems do not load after bundle update — help_parser ' \
           'unavailable under the bundled environment.')
  end
end

BootstrapRubyGems.new
